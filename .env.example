# Create a bot with BotFather and enter its token.
TELEGRAM_BOT_TOKEN=

# Optional HTTP or SOCKS5 proxy for the Telegram Bot API.
# Examples: http://127.0.0.1:2080 or socks5://127.0.0.1:2080
TELEGRAM_PROXY_URL=
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=

# Comma-separated allowed Telegram user IDs, for example 123456789,987654321.
TELEGRAM_ALLOWED_USER_IDS=

# Root directory for /new directory selection and the initial /shell directory.
# Defaults to /root.
CODEX_WORKSPACE_ROOT=/root
CODEX_BIN=codex

# Optional allowlist of host environment variable names that MCP server configs may reference.
# Set values in the service environment; never send secret values through Telegram.
TELECODEX_MCP_ENV_VARS=

# Leave empty to use the model configured by Codex app-server.
CODEX_MODEL=

# Local Telegram voice/audio transcription; the model downloads on first use.
TELECODEX_TRANSCRIPTION_MODEL=small
TELECODEX_TRANSCRIPTION_DEVICE=cpu
TELECODEX_TRANSCRIPTION_COMPUTE_TYPE=int8
TELECODEX_AUDIO_MAX_DURATION_SECONDS=300

# All bot runtime state is stored in SQLite outside the repository.
TELECODEX_DATABASE_FILE=~/.local/state/telecodex/state.sqlite3
# Legacy JSON state is imported automatically when the database is first created.
# Set this only during migration if the file is not in its default location.
# TELECODEX_STATE_FILE=~/.local/state/telecodex/state.json

# Controls network access for commands running inside Codex's sandboxed permission profiles.
# This does not disable built-in web search, MCP server traffic, or Codex service requests.
# /permissions Full Access bypasses the command sandbox.
CODEX_NETWORK_ACCESS=false
# Default permission policy for new chats; use /permissions to change the active thread.
CODEX_APPROVAL_POLICY=on-request
SHELL_TIMEOUT_SECONDS=60
# One-line JSON logs; DEBUG adds operation details but never payloads/secrets.
LOG_LEVEL=INFO
# Optional. Keeps pseudonymous log IDs stable when the bot token changes.
# Generate a random value and store it as a secret.
LOG_ID_SALT=
